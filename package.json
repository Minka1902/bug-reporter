{
  "name": "auto-github-bug-reporter",
  "version": "2.0.0",
  "description": "Zero-dependency error reporter that deduplicates runtime errors by fingerprint and files them as GitHub issues",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "src/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "bug-reporter",
    "error-tracker",
    "error-reporting",
    "error-monitoring",
    "github-issues",
    "runtime-errors",
    "uncaught-exception",
    "unhandled-rejection",
    "crash-reporting",
    "deduplication",
    "zero-dependencies"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minka1902/bug-reporter.git"
  },
  "bugs": {
    "url": "https://github.com/Minka1902/bug-reporter/issues"
  },
  "homepage": "https://github.com/Minka1902/bug-reporter#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
